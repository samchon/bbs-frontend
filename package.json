{
  "name": "bbs-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Next.js frontend for the samchon BBS SDK",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build:ui-test": "node scripts/build-for-ui-tests.mjs",
    "test:e2e": "pnpm build:ui-test && node scripts/run-playwright-tests.mjs",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "preview": "pnpm start",
    "mcp:playwright:install": "node scripts/install-playwright-mcp.mjs",
    "ui:review": "pnpm mcp:playwright:install && pnpm build:ui-test && node scripts/ui-review.mjs",
    "ui:trace": "pnpm exec playwright show-trace .artifacts/ui-review/ui-review-trace.zip"
  },
  "keywords": [
    "bbs",
    "react",
    "nextjs",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.10.0",
  "dependencies": {
    "@samchon/bbs-api": "^4.0.0",
    "@tanstack/react-query": "^5.99.0",
    "dompurify": "^3.3.3",
    "next": "^16.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  }
}
